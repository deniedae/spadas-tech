"use client";

import { useEffect } from "react";
import { useRouter, useSearchParams } from "next/navigation";
import { isAndroidAppEnvironment } from "@/lib/google-play-billing";

const MOBILE_INTENT_KEY = "spadas_mobile_intent";

function hasScannerIntent(): boolean {
  try {
    return localStorage.getItem(MOBILE_INTENT_KEY) === "scanner";
  } catch {
    return false;
  }
}

/**
 * MobileFirstLaunchRedirect:
 * Show the landing page by default to mobile web visitors, and only route
 * them directly to the scanner when they explicitly choose the scanner or are
 * running in an installed app container. This reduces drop-off caused by
 * forcing camera permissions before users understand the product.
 */
export function MobileFirstLaunchRedirect() {
  const router = useRouter();
  const searchParams = useSearchParams();

  useEffect(() => {
    if (typeof window === "undefined") return;

    const isExitRef = searchParams.get("ref") === "exit" || searchParams.get("stay") === "true";
    if (isExitRef) return;

    let hasExitedLens = false;
    try {
      hasExitedLens = sessionStorage.getItem("spadas_exited_lens") === "1";
    } catch {}
    if (hasExitedLens) return;

    const isAppContainer =
      isAndroidAppEnvironment() ||
      window.matchMedia("(display-mode: standalone)").matches ||
      document.referrer.includes("android-app://") ||
      Boolean((window as any).AndroidBridge);

    if (isAppContainer) {
      router.replace("/lens");
      return;
    }

    const isMobileWidth = window.innerWidth < 768;
    const isMobileUA =
      typeof navigator !== "undefined" &&
      /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(
        navigator.userAgent || "",
      );

    if ((isMobileWidth || isMobileUA) && hasScannerIntent()) {
      router.replace("/lens");
    }
  }, [router, searchParams]);

  return null;
}
