<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:padding="16dp">

    <!-- Header Section -->
    <LinearLayout
        android:id="@+id/header_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/txt_widget_brand"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="SPADAS AI"
            android:textColor="@color/cyan_accent"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LIVE"
            android:textColor="@color/emerald_profit"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Stats Row -->
    <LinearLayout
        android:id="@+id/stats_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/header_layout"
        android:layout_marginTop="8dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txt_stat_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_stat_label"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/txt_stat_profit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_stat_value"
            android:textColor="@color/text_light"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 1-Tap Quick Scan Action Button -->
    <Button
        android:id="@+id/btn_widget_scan"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_alignParentBottom="true"
        android:layout_marginTop="10dp"
        android:background="@drawable/btn_scan_widget_bg"
        android:text="@string/widget_scan_btn"
        android:textColor="@color/dark_bg"
        android:textSize="12sp"
        android:textStyle="bold" />
</RelativeLayout>
