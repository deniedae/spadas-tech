# ==============================================================================
# SPADAS TECH - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env.local and populate with your environment credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & AUTHENTICATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Comma-separated list of admin/founder emails for lifetime Pro access and diagnostic tools
ADMIN_EMAIL=admin@spadas.tech

# ------------------------------------------------------------------------------
# 2. SUPABASE (Database, Auth, and Storage)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Required for serverless database writes bypassing RLS (Stripe webhooks, scan telemetry)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ------------------------------------------------------------------------------
# 3. AI VISION & APPRAISAL ENGINES (Tiered Fallbacks)
# ------------------------------------------------------------------------------
# Primary Vision Model (High-Detail OCR and Sold Comps)
OPENAI_API_KEY=sk-proj-your-openai-api-key

# Secondary / High-Speed Vision Fallback (<300ms Lens Scanning)
GEMINI_API_KEY=your-gemini-api-key

# Optional AI Gateway / Vercel AI Routing
VERCEL_AI_KEY=
AI_GATEWAY_API_KEY=

# ------------------------------------------------------------------------------
# 4. MARKETPLACE VALUATION & SOLD COMPS SCRAPING
# ------------------------------------------------------------------------------
# Primary Sold Comps Scraper for eBay Australia
SOLD_COMPS_API_KEY=your-sold-comps-api-key

# Backup eBay Scraper (Optional)
SERPAPI_KEY=

# Barcode & Media Lookup APIs (Barcode Scanning Mode)
BARCODE_LOOKUP_API_KEY=
GOOGLE_BOOKS_API_KEY=
RAWG_API_KEY=
TMDB_API_KEY=

# ------------------------------------------------------------------------------
# 5. STRIPE PAYMENTS & SAAS SUBSCRIPTIONS
# ------------------------------------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret

# Stripe Price IDs for Subscription Tiers
STRIPE_PRICE_ID=price_your-default-pro-price-id
STRIPE_STARTER_PRICE_ID=price_your-starter-price-id
STRIPE_PRO_PRICE_ID=price_your-pro-price-id
STRIPE_ENTERPRISE_PRICE_ID=price_your-enterprise-price-id

# ------------------------------------------------------------------------------
# 6. EBAY DEVELOPER PROGRAM (Direct 1-Tap Inventory Publishing)
# ------------------------------------------------------------------------------
EBAY_CLIENT_ID=your-ebay-app-id
EBAY_CLIENT_SECRET=your-ebay-cert-id
EBAY_DEV_ID=your-ebay-dev-id
EBAY_RU_NAME=your-ebay-ru-name
# Options: production | sandbox
EBAY_ENVIRONMENT=production
EBAY_USER_REFRESH_TOKEN=

# ------------------------------------------------------------------------------
# 7. CRON & MAINTENANCE SECRETS
# ------------------------------------------------------------------------------
CRON_SECRET=your-cron-bearer-token
